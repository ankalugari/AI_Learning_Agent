PORT=3001

# ---- LLM (pick one; with no key the agent runs in offline "mock" mode) ----
# LLM_PROVIDER=anthropic | openai | mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings ----
# local  = free, runs on your machine (all-MiniLM-L6-v2, downloads ~25 MB the first time)
# openai = text-embedding-3-small (needs OPENAI_API_KEY)
# hash   = tiny keyword-hash vectors, no downloads (used automatically if local fails)
EMBEDDINGS_PROVIDER=local
